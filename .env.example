# Copy to .env (chmod 600). All three empty = guest-only, no sign-in.
# GOOGLE_*: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Web client.
# BB_BASE_URL: public origin, e.g. https://broombuster.com (redirect URI = <BB_BASE_URL>/auth/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BB_BASE_URL=
# Optional: BB_CSP=enforce turns the Content-Security-Policy from report-only to enforced.
