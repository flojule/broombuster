# Copy this file to .env and fill in only the sections you need.

# ── Production (required) ─────────────────────────────────────────────────────
# Needed whenever DEV_MODE is off (funnel.sh, the Pi systemd unit, any public
# deploy). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
REFRESH_SECRET=    # optional; defaults to JWT_SECRET + "-refresh"

# ── Optional: SQLite path override (default: <repo>/data/app.sqlite) ─────────
# DB_PATH=/path/to/app.sqlite   # systemd unit is read-only outside the repo: keep it under <repo>

# ── Preload region at boot (Pi warm-start) — avoids cold-first-request delay ──
# PRELOAD_REGION=bay_area

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO

# ── Dev mode — set to "true" to skip login on both API and frontend ───────────
# DEV_MODE=false

# ── Self-registration — set to "false" on public deploys (shared account only) ─
# When false, /auth/register returns 403 and the frontend hides "Create
# account". Seed the shared login with scripts/seed_account.py instead.
# ALLOW_REGISTRATION=true

# ── Email alerts (CLI only: --notify or SEND_NOTIFICATION in cli/main.py) ────
# Use a Gmail App Password — https://support.google.com/accounts/answer/185833
EMAIL_SENDER=you@gmail.com
EMAIL_RECEIVER=you@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
